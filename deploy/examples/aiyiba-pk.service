[Unit]
Description=AiYiBa multiplayer WebSocket service
After=network.target

[Service]
Type=simple
User=aiyiba
Group=aiyiba
WorkingDirectory=/srv/aiyiba/current
Environment=NODE_ENV=production
Environment=PK_HOST=127.0.0.1
Environment=PK_PORT=3001
Environment=SITE_ORIGIN=https://example.com
Environment=PK_ALLOWED_ORIGINS=https://example.com
Environment=PK_MAX_CONNECTIONS=200
Environment=PK_MAX_CONNECTIONS_PER_IP=24
Environment=PK_MAX_ROOMS=15
Environment=PK_MAX_ACTIVE_ROOMS_PER_IP=3
Environment=PK_MAX_ACTIVE_PLAYER_SEATS_PER_IP=8
# Optional anonymous gameplay analytics. Match the web service directory.
# Environment=ANALYTICS_LOG_DIR=/srv/aiyiba-analytics
# Environment=ANALYTICS_TRUST_PROXY=true
ExecStart=/usr/bin/npm run pk:server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=256M
# ReadWritePaths=/srv/aiyiba-analytics

[Install]
WantedBy=multi-user.target
