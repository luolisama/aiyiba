[Unit]
Description=AiYiBa web service
After=network.target

[Service]
Type=simple
User=aiyiba
Group=aiyiba
WorkingDirectory=/srv/aiyiba/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PK_ALLOWED_ORIGINS=https://example.com
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=256M

[Install]
WantedBy=multi-user.target
