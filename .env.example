# Public origin used by metadata, sitemap, sharing, and the multiplayer default. Replace in production.
SITE_ORIGIN=http://127.0.0.1:3000

# Optional webmaster verification token contents. Do not paste complete meta tags here.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Multiplayer origin checks. Replace this value in production; comma-separate multiple origins.
PK_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Multiplayer WebSocket service.
PK_HOST=127.0.0.1
PK_PORT=3001
PK_MAX_CONNECTIONS=200
PK_MAX_CONNECTIONS_PER_IP=24
PK_MAX_ROOMS=15
PK_MAX_ACTIVE_ROOMS_PER_IP=3
PK_MAX_ACTIVE_PLAYER_SEATS_PER_IP=8
PK_DISCONNECT_GRACE_MS=20000
PK_ROOM_TTL_MS=1800000
PK_LOBBY_ROOM_TTL_MS=600000
PK_ABSOLUTE_ROOM_TTL_MS=7200000
