{
  "name": "aiyiba",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "data:clue-index": "node scripts/build-clue-search-index.mjs",
    "analytics:summary": "node scripts/summarize-analytics.mjs",
    "pk:server": "node --env-file-if-exists=.env server/pk-server.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:unit": "node --test tests/game-logic.test.mjs tests/catalog.test.mjs tests/share-card-model.test.mjs tests/request-rate-limiter.test.mjs tests/analytics.test.mjs tests/local-game-engine.test.mjs tests/pk-client-logic.test.mjs tests/pk-game.test.mjs tests/pk-server.test.mjs tests/clue-client-logic.test.mjs",
    "test": "npm run test:unit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:unit",
    "verify:release": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "^4.120.0"
  },
  "type": "module"
}
